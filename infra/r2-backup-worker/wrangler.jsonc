{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "presence-monitor-r2-backup",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "presence-monitor-backups"
    }
  ]
}
